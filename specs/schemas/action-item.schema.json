{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wpknowledge.local/schemas/action-item/v1",
  "title": "Action Item",
  "type": "object",
  "additionalProperties": false,
  "required": ["actionItemId", "type", "severity", "status", "subject", "runId", "reasonCode", "summary", "sourceEventId", "fingerprint", "allowedActions", "revision", "createdAt", "updatedAt", "resolvedAt", "resolution", "previousOccurrenceId"],
  "properties": {
    "actionItemId": { "type": "string", "pattern": "^ai_[a-f0-9]{24}$" },
    "type": { "enum": ["RUN_FAILED", "LOW_CONFIDENCE", "GATE_STOPPED", "COMPONENT_UNAVAILABLE"] },
    "severity": { "enum": ["MEDIUM", "HIGH"] },
    "status": { "enum": ["OPEN", "ACKNOWLEDGED", "RESOLVED"] },
    "subject": { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "const": "RUN" }, "id": { "type": "string", "minLength": 1 } } },
    "runId": { "type": ["string", "null"] },
    "reasonCode": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "sourceEventId": { "type": "string", "minLength": 1 },
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "allowedActions": { "type": "array", "uniqueItems": true, "items": { "enum": ["ACKNOWLEDGE", "RESOLVE", "RETRY", "REGENERATE"] } },
    "revision": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "resolvedAt": { "type": ["string", "null"], "format": "date-time" },
    "resolution": { "type": ["object", "null"] },
    "previousOccurrenceId": { "type": ["string", "null"] }
  }
}
