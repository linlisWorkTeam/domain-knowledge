# 文件功能：维护gitignore相关的项目配置与工程说明。
# Python and local browser/test artifacts
**/__pycache__/
*.py[cod]
.playwright-cli/
playwright-report/
test-results/

# Atomic-write leftovers
knowledge/**/*.tmp
knowledge/**/*.write-*

# Knowledge flywheel local runtime
.workpanel/
*.sqlite
*.sqlite-shm
*.sqlite-wal
node_modules/

# Local operator configuration and secrets
.env.local
