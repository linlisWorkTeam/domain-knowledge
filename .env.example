# 将本文件复制为 .env.local，并把占位值替换成本地密钥。
# 不要提交 .env.local。
WP_KNOWLEDGE_WRITE_TOKEN=replace-with-a-long-random-token
WP_FLYWHEEL_HOME=.workpanel
# 可选：把知识摄取和扫描根目录指向 wpKnowledge 的本地检出。
WP_KNOWLEDGE_REPOSITORY=../wpKnowledge
# 可选：仅允许来源注册访问这些 HTTPS host，逗号分隔；默认拒绝所有远程 host。
# WP_SOURCE_ALLOWED_HOSTS=docs.example.com,raw.githubusercontent.com
# HTTPS 来源的 credentialRef 使用 secret://env/变量名，只在服务端解析对应环境变量。
# WP_SOURCE_TOKEN=replace-with-a-source-access-token
