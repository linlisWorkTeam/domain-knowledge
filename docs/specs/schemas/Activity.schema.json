{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wpknowledge.local/schemas/activity/v1",
  "title": "Activity",
  "type": "object",
  "additionalProperties": false,
  "required": ["activityId", "cursor", "type", "occurredAt", "runId", "subject", "summary", "severity", "eventId", "links"],
  "properties": {
    "activityId": { "type": "string", "minLength": 1 },
    "cursor": { "type": "string", "pattern": "^act_[A-Za-z0-9_-]+$" },
    "type": { "type": "string", "minLength": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "runId": { "type": ["string", "null"] },
    "subject": { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "enum": ["RUN", "KNOWLEDGE"] }, "id": { "type": "string", "minLength": 1 } } },
    "summary": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["INFO", "HIGH"] },
    "eventId": { "type": "string", "minLength": 1 },
    "links": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["rel", "href"], "properties": { "rel": { "type": "string" }, "href": { "type": "string" } } } }
  }
}
