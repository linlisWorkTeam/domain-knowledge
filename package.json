{
  "name": "domain-knowledge-agent-framework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LangGraph-based multi-agent framework for domain knowledge generation and verification.",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-typescript.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preverify:company": "npm run build --silent",
    "verify:company": "node scripts/verify-company-dependencies.mjs",
    "precli": "npm run build --silent",
    "cli": "node dist/src/cli.js"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.13",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
