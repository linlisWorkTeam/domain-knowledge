{
  "name": "@linlis-workteam/domain-knowledge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "knowledge": "node --env-file-if-exists=.env.local src/interfaces/runner/cli.ts",
    "knowledge:serve": "node --env-file-if-exists=.env.local src/interfaces/ui-api/index.ts",
    "site:serve": "node site/dev-server.mjs",
    "site:check": "node --test tests/contract/site.test.ts",
    "test:ui": "playwright test",
    "acceptance:ohmyworkpanel": "node --env-file-if-exists=.env.local src/interfaces/runner/project-acceptance.ts",
    "test": "node --test --test-concurrency=1",
    "test:architecture": "node --test tests/contract/architecture.test.ts",
    "test:domain": "node --test tests/unit",
    "test:integration": "node --test --test-concurrency=1 tests/integration",
    "test:acceptance": "node --test --test-concurrency=1 tests/acceptance",
    "typecheck": "tsc --noEmit",
    "validate:specs": "node specs/13-verification/validate-specs.ts",
    "evaluate:framework": "node scripts/evaluate-framework.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-sdk-client": "0.1.2-alpha.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@langchain/langgraph": "1.4.13",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "undici": "8.9.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
